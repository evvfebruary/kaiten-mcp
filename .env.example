# Required for local stdio MCP (Cursor / Claude Code)
KAITEN_API_TOKEN=

# Required: workspace slug for https://{slug}.kaiten.ru
# Example: acme -> https://acme.kaiten.ru/api/v1
KAITEN_WORKSPACE_SLUG=

# Optional: full API root override for custom/on-prem domains.
# When set, takes precedence over KAITEN_WORKSPACE_SLUG.
# KAITEN_BASE_URL=https://kaiten.example.com/api/v1

KAITEN_HOST=0.0.0.0
KAITEN_PORT=8000

# Logging (always stderr — safe for stdio MCP)
KAITEN_LOG_LEVEL=INFO
KAITEN_LOG_FORMAT=text
# text | json
KAITEN_LOG_BODIES=false
# When true, include compact redacted result previews in tool_success logs

KAITEN_ENABLE_METRICS=false

# Optional dedicated cloud board for `kaiten-mcp-check live`.
# Export these values into the process environment before running the check.
# KAITEN_TEST_SPACE_ID=1
# KAITEN_TEST_BOARD_ID=2
# KAITEN_TEST_COLUMN_ID=3
# KAITEN_TEST_TARGET_COLUMN_ID=5
# KAITEN_TEST_LANE_ID=4
# KAITEN_TEST_TAG_ID=8
# KAITEN_TEST_TAG_NAME=mcp-test
